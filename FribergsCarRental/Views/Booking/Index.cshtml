@model IEnumerable<FribergsCarRental.Models.Booking>

@{
    ViewData["Title"] = "Index";
}

<h1>Bokningar</h1>

@if (Model != null && Model.Any())
{
    var upcomingBookings = Model.Where(b => b.Status == Status.Upcoming).ToList();
    var ongoingBookings = Model.Where(b => b.Status == Status.Ongoing).ToList();
    var completedBookings = Model.Where(b => b.Status == Status.Completed).ToList();

    @for (int i = 0; i < 3; i++)
    {
        string th;
        string buttonText = "";
        string newStatus = "";
        List<FribergsCarRental.Models.Booking> bookinglist;
        if (i == 0)
        {
            bookinglist = upcomingBookings;
            th = "Kommande bokningar";
            buttonText = "Lämna ut bil";
            newStatus = "Ongoing";
        }
        else if (i == 1)
        {
            bookinglist = ongoingBookings;
            th = "Pågående bokningar";
            buttonText = "Avsluta bokning";
            newStatus = "Completed";
        }
        else
        {
            bookinglist = completedBookings;
            th = "Avslutade bokningar";
        }
        <h3 class="table mt-5">@th</h3>
        <table class="table mb-2 mt-2">
            <thead>
                <tr>
                    @if (ViewBag.User == "Admin")
                    {
                        <th>
                            @Html.DisplayNameFor(model => model.Customer.FirstName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Customer.LastName)
                        </th>
                    }
                    <th>
                        @Html.DisplayNameFor(model => model.Car.Brand)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Car.Model)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Car.YearModel)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.StartDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.EndDate)
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in bookinglist)
                {
                    <tr>
                        @if (ViewBag.User == "Admin")
                        {
                            <td>
                                @Html.DisplayFor(modelItem => item.Customer.FirstName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Customer.LastName)
                            </td>
                        }
                        <td>
                            @Html.DisplayFor(modelItem => item.Car.Brand)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Car.Model)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Car.YearModel)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.StartDate)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.EndDate)
                        </td>
                        <td>
                            <div class="d-flex gap-2 align-items-center">
                                @if (bookinglist == upcomingBookings && ViewBag.User == "Admin" || bookinglist == ongoingBookings && ViewBag.User == "Admin")
                                {
                                    <form asp-action="ChangeStatus" method="post">
                                        <input type="hidden" name="bookingId" value="@item.BookingId" />
                                        <input type="hidden" name="newStatus" value="@newStatus" />
                                        <button type="submit" class="btn btn-dark">@buttonText</button>
                                    </form>
                                }
                                <a asp-action="Details" asp-route-id="@item.BookingId"><i class="fa-solid fa-circle-info"></i></a>&nbsp;
                                @if (bookinglist == upcomingBookings)
                                {
                                    <a asp-action="Delete" asp-route-id="@item.BookingId"><i class="fa-solid fa-trash"></i></a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    }
}
else
{
    <p>@ViewBag.ErrorMsg</p>
}




