@model FribergsCarRental.ViewModels.BookingsDisplayViewModel
@{
    ViewData["Title"] = "Index";
}

<div class="container mt-5">
    <ul class="nav nav-tabs" id="bookingTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="ongoing-tab" data-bs-toggle="tab" data-bs-target="#ongoing" type="button" role="tab" aria-controls="ongoing" aria-selected="true">
                Pågående
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="upcoming-tab" data-bs-toggle="tab" data-bs-target="#upcoming" type="button" role="tab" aria-controls="upcoming" aria-selected="false">
                Kommande
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed" type="button" role="tab" aria-controls="completed" aria-selected="false">
                Avslutad
            </button>
        </li>
    </ul>
    <div class="tab-content" id="bookingTabsContent">
        <div class="tab-pane fade show active mt-2" id="ongoing" role="tabpanel" aria-labelledby="ongoing-tab">
            <h3>Pågående Bokningar</h3>
            @if (Model.OngoingBookings.Any())
            {
                <table class="table mb-2 mt-2">
                    <thead>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Booking.Car.Brand)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Booking.Car.Model)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Booking.Car.YearModel)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Booking.StartDate)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Booking.EndDate)
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OngoingBookings)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Car.Brand)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Car.Model)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Car.YearModel)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.StartDate)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.EndDate)
                                </td>
                                <td>
                                    <div class="d-flex gap-2 align-items-center">
                                        <a asp-action="Details" asp-route-id="@item.BookingId" title="Detaljer"><i class="fa-solid fa-circle-info"></i></a>&nbsp;
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>Inga pågående bokningar.</p>
            }
        </div>
        <div class="tab-pane fade mt-2" id="upcoming" role="tabpanel" aria-labelledby="upcoming-tab">
            <h3>Kommande Bokningar</h3>
            @if (Model.UpcomingBookings.Any())
            {
                <table class="table mb-2 mt-2">
                    <thead>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Booking.Car.Brand)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Booking.Car.Model)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Booking.Car.YearModel)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Booking.StartDate)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Booking.EndDate)
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.UpcomingBookings)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Car.Brand)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Car.Model)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Car.YearModel)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.StartDate)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.EndDate)
                                </td>
                                <td>
                                    <div class="d-flex gap-2 align-items-center">
                                        <a asp-action="Details" asp-route-id="@item.BookingId" title="Detaljer"><i class="fa-solid fa-circle-info"></i></a>&nbsp;
                                        <a asp-action="Delete" asp-route-id="@item.BookingId" class="btn btn-danger btn-sm">Avboka</a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>Inga kommande bokningar.</p>
            }
        </div>
        <div class="tab-pane fade mt-2" id="completed" role="tabpanel" aria-labelledby="completed-tab">
            <h3>Avslutade Bokningar</h3>
            @if (Model.CompletedBookings.Any())
            {
                <table class="table mb-2 mt-2">
                    <thead>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Booking.Car.Brand)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Booking.Car.Model)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Booking.Car.YearModel)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Booking.StartDate)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Booking.EndDate)
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.CompletedBookings)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Car.Brand)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Car.Model)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Car.YearModel)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.StartDate)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.EndDate)
                                </td>
                                <td>
                                    <div class="d-flex gap-2 align-items-center">
                                        <a asp-action="Details" asp-route-id="@item.BookingId" title="Detaljer"><i class="fa-solid fa-circle-info"></i></a>&nbsp;
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>Inga avslutade bokningar.</p>
            }
        </div>
    </div>
</div>

