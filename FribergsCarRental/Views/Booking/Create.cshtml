@model FribergsCarRental.ViewModels.BookingViewModel

@{
    ViewData["Title"] = "Create";
}

@if (ViewBag.ErrorMsg != null)
{
    <div class="alert alert-danger">
        <p>@ViewBag.ErrorMsg</p>
    </div>
    @if (Model.FutureBookings != null && Model.FutureBookings.Any())
    {
        <div class="alert alert-danger">
            @foreach (var booking in Model.FutureBookings)
            {
                <p>@booking.StartDate.ToString("yyyy-MM-dd") - @booking.EndDate.ToString("yyyy-MM-dd")</p>
            }
        </div>
    }
}

<h1>Boka bil</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Booking.CustomerId" />
            <input type="hidden" asp-for="Booking.CarId" />
            <input type="hidden" asp-for="Booking.TotalCost" />
            <div class="form-group">
                <label asp-for="Booking.StartDate" class="control-label"></label>
                <input type="date" asp-for="Booking.StartDate" class="form-control" value="@(Model?.Booking.StartDate.ToString("yyyy-MM-dd") ?? "")" />
                <span asp-validation-for="Booking.StartDate" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Booking.EndDate" class="control-label"></label>
                <input type="date" asp-for="Booking.EndDate" class="form-control" value="@(Model?.Booking.EndDate.ToString("yyyy-MM-dd") ?? "")" />
                <span asp-validation-for="Booking.EndDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Boka" class="btn btn-dark" />
                <a asp-controller="Car" asp-action="ClearCarSessionAndRedirect" class="btn btn-danger">Avbryt</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const startDateInput = document.querySelector('input[name="Booking.StartDate"]');
        const endDateInput = document.querySelector('input[name="Booking.EndDate"]');

        startDateInput.addEventListener('change', () => {
            const startDateValue = new Date(startDateInput.value);
            if (!isNaN(startDateValue.getTime())) {

                const endDateValue = new Date(startDateValue);
                endDateValue.setDate(endDateValue.getDate() + 1);

                endDateInput.value = endDateValue.toISOString().split('T')[0];
            }
        });
    </script>
}
