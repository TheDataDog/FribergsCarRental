@model FribergsCarRental.Models.Booking

@{
    ViewData["Title"] = "BookingConfirmation";
}

<h1>Bokningsbekräftelse</h1>

<h4>Nedan finner du detaljer för din bokning</h4>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.StartDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.StartDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EndDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EndDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TotalCost)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TotalCost) kr
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Customer)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Customer.FirstName)
            @Html.DisplayFor(model => model.Customer.LastName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Customer.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Customer.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Car)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Car.Brand)
            @Html.DisplayFor(model => model.Car.Model)
            @Html.DisplayFor(model => model.Car.YearModel)
        </dd>
    </dl>
</div>
<div>
    <p>Om du har frågor om din bokning, tveka inte att <a asp-controller="Home" asp-action="Contact">kontakta oss</a>.</p>
    <p>Vid förhinder kan du avboka dina kommande bokningar under <a asp-action="Index">Mina Bokningar</a>.</p>
</div>
<div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-dark">Stäng</a>
</div>
