@model FribergsCarRental.Models.Car

@{
    ViewData["Title"] = "ShowCar";
}

<h1 style="text-align:center; margin-bottom: 50px; margin-top: 50px">@Model.Brand @Model.Model @Model.YearModel</h1>

<div class="container">
    <div class="row">
        <div class="col-md-5 mb-4">
            <p style="font-size:1.5em; font-weight:bold">
                @Model.Brand @Model.Model @Model.YearModel Specifikationer
            </p>
            <p>
                <i class="fa-solid fa-user"></i>&nbsp;@Model.PassengerSeats
            </p>
            <p>
                <i class="fa-solid fa-gas-pump"></i>&nbsp;@Model.FuelConsumption l/100km
            </p>
            <p>
                <i class="fa-solid fa-horse"></i>&nbsp;@Model.HorsePower hk
            </p>
            <p>
                @Model.Description
            </p>
            <div class="button-price d-flex gap-3">
                <div>
                    <p style="font-size:1.5em; font-weight:bold">@Model.DailyCost kr/dygn</p>
                </div>
                <div>
                    <a asp-action="Book" asp-route-id="@Model?.CarId" class="btn btn-dark">Boka</a>
                </div>
            </div>
        </div>
        <div class="col-md-7 mb-4">
            @if (Model.Pictures != null && Model.Pictures.Any())
            {
                <div id="carouselShowCar" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @for(int i=0; i < Model.Pictures.Count; i++)
                        {
                            if(i == 0)
                            {
                                <div class="carousel-item active">
                                    <img class="d-block w-100" src="@Model.Pictures[i]" alt="Slide">
                                </div>
                            }
                            else
                            {
                                <div class="carousel-item">
                                    <img class="d-block w-100" src="@Model.Pictures[i]" alt="Slide">
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
    <a asp-action="Index">Tillbaka</a>
</div>
