@model FribergsCarRental.Models.Car

@{
    ViewData["Title"] = "ShowCar";
}

<h1 style="text-align:center; margin-bottom: 50px; margin-top: 50px">@Model.Brand @Model.Model @Model.YearModel</h1>

<div class="container">
    <div class="row">
        <div class="col-md-5 mb-4">
            <p style="font-size:1.5em; font-weight:bold">
                @Model.Brand @Model.Model @Model.YearModel Specifikationer
            </p>
            <p>
                <i class="fa-solid fa-user"></i>&nbsp;@Model.PassengerSeats
            </p>
            <p>
                <i class="fa-solid fa-gas-pump"></i>&nbsp;@Model.FuelConsumption l/100km
            </p>
            <p>
                <i class="fa-solid fa-horse"></i>&nbsp;@Model.HorsePower hk
            </p>
            <p>
                @Model.Description
            </p>
        </div>
        <div class="col-md-7 mb-4">
            @if (Model.Pictures != null && Model.Pictures.Any())
            {
                <img src="@Model.Pictures[0]" alt="car" style="height:500px; width:auto" />
            }
        </div>
    </div>
    <a asp-action="Book" asp-route-id="@Model?.CarId" class="btn btn-primary">Boka</a>
</div>
<div>
    <h4>Car</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Pictures)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Pictures)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Brand)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Brand)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Model)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Model)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.YearModel)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.YearModel)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.HorsePower)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.HorsePower)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FuelConsumption)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FuelConsumption)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DailyCost)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DailyCost)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PassengerSeats)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PassengerSeats)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.CarId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
