@model IEnumerable<FribergsCarRental.Models.Car>

@{
    ViewData["Title"] = "Index";
}

<h1>Våra Bilar</h1>
<div class="container">
    <div class="row">
        @*     <div class="col-md-4"> *@
        @foreach (var item in Model)
        {
            if (item.Pictures != null && item.Pictures.Any())
            {
                <div class="col-md-4 col-xl-3 col-sm-6 mb-4">
                    <div class="d-flex justify-content-center align-items-center">
                        <div class="card" style="width: 18rem;">
                            <img src="@item.Pictures[0]" class="card-img-top" alt="car">
                            <div class="card-body">
                                <h5 class="card-title">@item.Brand @item.Model @item.YearModel</h5>
                                <p class="card-text">
                                    <i class="fa-solid fa-user"></i>&nbsp;@item.PassengerSeats &nbsp;&nbsp;&nbsp;
                                    <i class="fa-solid fa-gas-pump"></i>&nbsp;@item.FuelConsumption l/100km&nbsp;&nbsp;&nbsp;&nbsp;
                                    <i class="fa-solid fa-horse"></i>&nbsp;@item.HorsePower hk
                                </p>
                                <p style="font-size:1.3em; font-weight:bold">
                                    @item.DailyCost kr/dygn
                                </p>
                                @* <a href="#" class="btn btn-primary">Läs mer & boka</a> *@
                                <a asp-action="ShowCar" asp-route-id="@item.CarId" class="btn btn-primary">Läs mer & boka</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        @*  </div> *@
    </div>
</div>

