@model FribergsCarRental.Models.Car

@{
    ViewData["Title"] = "Delete";
}

<h1>Ta bort</h1>

<h4>Är du säker på att du vill radera denna bilen?</h4>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Brand)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Brand)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Model)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Model)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.YearModel)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.YearModel)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.HorsePower)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.HorsePower)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FuelConsumption)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FuelConsumption)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PassengerSeats)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PassengerSeats)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DailyCost)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DailyCost)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IsActive)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IsActive)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="CarId" />
        <input type="submit" value="Radera" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-dark">Tillbaka</a>
    </form>
</div>
<div class="toast" data-bs-autohide="false" role="alert" aria-live="assertive" aria-atomic="true" id="errorToast">
    <div class="toast-body">
        @ViewBag.ErrorMsg
        <div class="mt-2 pt-2 border-top">
            <a asp-action="Edit" asp-route-id="@Model.CarId" class="btn btn-dark btn-sm">Editera</a>
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="toast">Stäng</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const errorMsg = '@ViewBag.ErrorMsg';
            if (errorMsg) {
                const toastElement = document.getElementById('errorToast');
                const toast = new bootstrap.Toast(toastElement);
                toast.show();
            }
        });
    </script>
}
