@model FribergsCarRental.Models.Car

@{
    ViewData["Title"] = "Edit";
}

<h1>Ändra bil</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CarId" />
            <div class="form-group">
                <label asp-for="Brand" class="control-label"></label>
                <input asp-for="Brand" class="form-control" readonly />
                <span asp-validation-for="Brand" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Model" class="control-label"></label>
                <input asp-for="Model" class="form-control" readonly />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="YearModel" class="control-label"></label>
                <input asp-for="YearModel" class="form-control" readonly />
                <span asp-validation-for="YearModel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HorsePower" class="control-label"></label>
                <input asp-for="HorsePower" class="form-control" readonly />
                <span asp-validation-for="HorsePower" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FuelConsumption" class="control-label"></label>
                <input asp-for="FuelConsumption" class="form-control" readonly />
                <span asp-validation-for="FuelConsumption" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PassengerSeats" class="control-label"></label>
                <input asp-for="PassengerSeats" class="form-control" readonly />
                <span asp-validation-for="PassengerSeats" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DailyCost" class="control-label"></label>
                <input asp-for="DailyCost" class="form-control" />
                <span asp-validation-for="DailyCost" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="8"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <div id="pictures-container">
                    <label asp-for="Pictures" class="control-label"></label>
                </div>
                <span asp-validation-for="Pictures" class="text-danger"></span>
                <input type="button" value="Lägg till bild" class="btn btn-primary" onclick="addPicture()" />
            </div>
            <div class="form-group">
                @* //Ska det vara en form-group här??? *@
                <div>
                    @if (Model.Pictures != null && Model.Pictures.Any())
                    {
                        @for (int i = 0; i < Model.Pictures.Count; i++)
                        {

                            <tr id="row-@i">
                                <td>
                                    <img src="@Model.Pictures[i]" id="img-@i" alt="car" style="width: 200px; height:auto;" />
                                    <input type="hidden" name="Pictures" value="@Model.Pictures[i]" id="hidden-@i" />
                                    <input type="button" value="Ta bort bild" class="btn btn-danger" id="button-@i" onclick="deletePicture(@i)" />
                                    <br /> @* //styla på riktigt här *@
                                    <br />
                                </td>
                            </tr>

                        }

                    }
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Spara" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Tillbaka</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function addPicture() {
            const container = document.getElementById('pictures-container');
            const newInput = document.createElement('input');
            newInput.setAttribute('name', 'Pictures');
            newInput.setAttribute('class', 'form-control mt-2');
            container.appendChild(newInput);
        }

        function deletePicture(index) {
            const picture = document.getElementById(`img-${index}`);
            const hiddenInput = document.getElementById(`hidden-${index}`)
            const row = document.getElementById(`row-${index}`)
            const button = document.getElementById(`button-${index}`);
            if (picture) {
                picture.remove();
            }

            if (hiddenInput) {
                hiddenInput.remove();
            }

            if (row) {
                roe.remove();
            }

            if (button) {
                button.remove();
            }


        }
    </script>
}
