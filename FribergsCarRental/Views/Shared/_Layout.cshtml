@inject SessionHelper sessionHelper
@{
    var user = sessionHelper.GetUserSession();
    string bokningar = "Mina bokningar";
    string bilar = "Våra Bilar";

    if (user.Role == 0)
    {
        bokningar = "Bokningar";
        bilar = "Bilar";
    }

}
@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var actionName = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="sv-se">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FribergsCarRental</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FribergsCarRental.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.css" />

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow" style="padding:0px">
            <div class="container-fluid d-flex justify-content-between align-items-center" style="background-color:#E3EBEE">
                <div class="left d-flex align-items-center">
              <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><img src="~/images/FribergCarRental-logo.jpg" alt="logo" style="width: 75px; height:auto; margin:0.3em" /></a>
                  <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Friberg Car Rental</a>
                  </div>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="right navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    
                    <ul class="navbar-nav d-flex flex-sm-column flex-md-row flex-lg-row flex-xl-row flex-xxl-row">
                        <li class="nav-item me-3">
                            <a class="nav-link text-dark fs-5" asp-area="" asp-controller="Car" asp-action="Index">@bilar</a>
                        </li>
                        @if(user.Role == 0)
                        {
                            <li class="nav-item me-3">
                                <a class="nav-link text-dark fs-5" asp-area="" asp-controller="Customer" asp-action="Index">Kunder</a>
                            </li>
                        }
                        @if(user.Role != null)
                        {
                            <li class="nav-item me-3">
                                <a class="nav-link text-dark fs-5" asp-area="" asp-controller="Booking" asp-action="Index">@bokningar</a>
                            </li>
                        }
                        @if (user.Role != 0)
                        {
                            <li class="nav-item me-3">
                                <a class="nav-link text-dark fs-5" asp-area="" asp-controller="Home" asp-action="Conditions">Våra villkor</a>
                            </li>
                            <li class="nav-item me-3">
                                <a class="nav-link text-dark fs-5" asp-area="" asp-controller="Home" asp-action="Contact">Kontakta oss</a>
                            </li>
                        }
                        @if(user.Role == null)
                        {
                            <li class="nav-item me-3">
                                <a class="nav-link text-dark fs-5" asp-area="" asp-controller="Customer" asp-action="Login">Logga in</a>
                            </li>
                        }
                        @if(user.Role != null)
                        {
                            <li class="nav-item me-3">
                                <a class="nav-link text-dark fs-5" asp-area="" asp-controller="Customer" asp-action="Logout">Logga ut</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @if(controllerName == "Home" && actionName == "Index")
    {
        <div class="container-fluid p-0 m-0">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <div class="container mt-3">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="border-top footer text-muted" style="background-color:#E3EBEE;">
        <div class="container d-flex justify-content-center">
            &copy; 2025 - FribergsCarRental - All Rights Reserved
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
