@inject SessionHelper sessionHelper
<!DOCTYPE html>
<html lang="sv-se">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FribergsCarRental</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FribergsCarRental.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.css" />

</head>
<body>
    <header>
        @* <div class="logo container-fluid d-flex justify-content-center align-items-center" style="background-color:#E3EBEE">
            <img src="~/images/FribergCarRental-logo.jpg" alt="logo" style="width: 150px; height:auto; padding-bottom:5px; padding-top:5px;" />
        </div> *@
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow" style="padding:0px">
            <div class="container-fluid" style="background-color:#E3EBEE">
              <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><img src="~/images/FribergCarRental-logo.jpg" alt="logo" style="width: 75px; height:auto; margin:0.3em" /></a>
                  <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Friberg Car Rental</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @{
                        var user = sessionHelper.GetUserSession();
                        string bokningar = "Mina bokningar";
                        string bilar = "Våra Bilar";

                        if(user.Role == 0)
                        {
                            bokningar = "Bokningar";
                            bilar = "Bilar";
                        }

                    }
                    <ul class="navbar-nav flex-grow-1">
                        @* <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li> *@
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Car" asp-action="Index">@bilar</a>
                        </li>
                        @if(user.Role == 0)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Customer" asp-action="Index">Kunder</a>
                            </li>
                        }
                        @if(user.Role != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Booking" asp-action="Index">@bokningar</a>
                            </li>
                        }
                        @if (user.Role != 0)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Conditions">Våra villkor</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Contact">Kontakta oss</a>
                            </li>
                        }
                        @if(user.Role == null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Customer" asp-action="Login">Logga in</a>
                            </li>
                        }
                        @if(user.Role != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Customer" asp-action="Logout">Logga ut</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @{
        var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
        var actionName = ViewContext.RouteData.Values["action"]?.ToString(); 
    }
    @if(controllerName == "Home" && actionName == "Index")
    {
        <div class="container-fluid p-0 m-0">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <div class="container mt-3">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - FribergsCarRental - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
