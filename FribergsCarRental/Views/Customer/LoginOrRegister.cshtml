<div class="container">
    <div class="row">
        <!-- Login Column -->
        <div class="col-md-6">
            <div class="login border p-3">
                @* <h2>Logga in</h2> *@
                @Html.Partial("Login")
            </div>
        </div>

        <!-- Register Column -->
        <div class="col-md-6">
            <div class="register border p-3">
                <h2>Registrera dig som kund</h2>
                @Html.Partial("Create", new Customer { UserRole = new UserRole { Role = Role.Customer }})
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}