@using FribergsCarRental.ViewModels

@{
    ViewData["Title"] = "LoginOrRegister";
}

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <div class="login border p-3">
                @await Html.PartialAsync("Login", new LoginViewModel { ReturnUrl = ViewBag.ReturnUrl })
            </div>
        </div>
        <div class="col-md-6">
            <div class="register border p-3">
                <h2>Registrera dig som kund</h2>
                @await Html.PartialAsync("Create", new CustomerCreateViewModel { Customer = new Customer { UserRole = new UserRole { Role = Role.Customer } }, ReturnUrl = ViewBag.ReturnUrl })
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}