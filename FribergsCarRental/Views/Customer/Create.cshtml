@* @model FribergsCarRental.Models.Customer *@
@model FribergsCarRental.ViewModels.CustomerCreateViewModel

@{
    ViewData["Title"] = "Create";
    string columnClass = ViewBag.User == "Admin" ? "col-md-4" : "col-md-8";
}

@if (ViewBag.ErrorMsgCreateCustomer != null)
{
    <div class="alert alert-danger">
        <p>@ViewBag.ErrorMsgCreateCustomer</p>
    </div>
}

@if (ViewBag.User == "Admin")
{
    <h1>Lägg till kund</h1>

    <hr />
}

<div class="row">
    <div class="@columnClass">
        <form asp-action="Create" onsubmit="return validateForm()">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Customer.UserRole.Role" />
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="form-group">
                <label asp-for="Customer.FirstName" class="control-label"></label>
                <input asp-for="Customer.FirstName" class="form-control" />
                <span asp-validation-for="Customer.FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Customer.LastName" class="control-label"></label>
                <input asp-for="Customer.LastName" class="form-control" />
                <span asp-validation-for="Customer.LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Customer.Birthdate" class="control-label"></label>
                <input asp-for="Customer.Birthdate" class="form-control" type="date" value="" />
                <span asp-validation-for="Customer.Birthdate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Customer.PhoneNumber" class="control-label"></label>
                <input asp-for="Customer.PhoneNumber" class="form-control" />
                <span asp-validation-for="Customer.PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Customer.Email" class="control-label"></label>
                <input asp-for="Customer.Email" class="form-control" />
                <span asp-validation-for="Customer.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Customer.Password" class="control-label"></label>
                <input asp-for="Customer.Password" class="form-control" type="password" />
                <span asp-validation-for="Customer.Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Customer.Adress.Street" class="control-label"></label>
                <input asp-for="Customer.Adress.Street" class="form-control" />
                <span asp-validation-for="Customer.Adress.Street" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Customer.Adress.StreetNumber" class="control-label"></label>
                <input asp-for="Customer.Adress.StreetNumber" class="form-control" />
                <span asp-validation-for="Customer.Adress.StreetNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Customer.Adress.ZipCode" class="control-label"></label>
                <input asp-for="Customer.Adress.ZipCode" class="form-control" />
                <span asp-validation-for="Customer.Adress.ZipCode" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Customer.Adress.City" class="control-label"></label>
                <input asp-for="Customer.Adress.City" class="form-control" />
                <span asp-validation-for="Customer.Adress.City" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Registrera" class="btn btn-dark" />
                @if (ViewBag.User == "Admin")
                {
                    <a asp-action="Index" class="btn btn-danger">Avbryt</a>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

