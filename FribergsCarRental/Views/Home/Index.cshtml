<style>
    .carousel-item img {
        height: 400px;
        width: 100%;
        object-fit: cover;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="carousel col-sm p-0">
            <div id="carouselIndex" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @if (Model.Pictures != null && Model.Pictures.Any())
                    {
                        bool isFirst = true;
                        @foreach (var url in Model.Pictures)
                        {
                            <div class="carousel-item @(isFirst ? "active" : "")">
                                <img class="d-block w-100" src="@url" alt="Slide">
                            </div>
                            isFirst = false;
                        }
                    }
                </div>
            </div>
        </div>
        <div class="quote col-sm d-flex justify-content-center align-items-center" style="background-color:#97A6AD;">
            <div class="quote-text" style="font-size:3em; font-style:italic; text-align:center">
                <p>"Hyr lyxen,</p>
                <p>äg upplevelsen!"</p>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid m-0 p-0">
    <div class="background" style="background-color:#E3EBEE">
        <div class="row">
            <div class="col-sm">
            </div>
            <div class="col-sm-8 text-container">
                <div class="text-presentation text-center" style="font-size:1.2em; padding-top:4em; padding-bottom:4em;">
                    <p>
                        Friberg Car Rentals, grundat 2020 av Marcus Friberg, är en exklusiv biluthyrningsfirma belägen i Scriptås. 
                        Företaget erbjuder 12 lyxbilar från välkända märken som Rolls-Royce, Bentley, Mercedes, BMW, Cadillac och Lexus.
                        Med fokus på service i toppklass och förstklassiga fordon är målet att ge varje kund en oförglömlig upplevelse, 
                        oavsett om det gäller ett speciellt tillfälle eller ren körglädje. Friberg Car Rentals är det självklara valet för lyx och stil på vägarna.
                    </p>
                </div>
            </div>
            <div class="col-sm">
            </div>
        </div>
    </div>
</div>

@* <div class="container"> *@
<div class="row mt-5">
    @foreach (var item in Model.Cars)
    {
        if (item.Pictures != null && item.Pictures.Any())
        {
            <div class="col-md-4 col-xl-3 col-sm-6 mb-4">
            <div class="d-flex justify-content-center align-items-center mx-5">
                    <div class="card" style="width: 18rem;">
                        <img src="@item.Pictures[0]" class="card-img-top" alt="car">
                        <div class="card-body">
                            <h5 class="card-title">@item.Brand @item.Model @item.YearModel</h5>
                            <div class="d-flex justify-content-between mb-2">
                                <p class="card-text d-flex w-100 justify-content-between">
                                    <span class="d-flex align-items-center">
                                        <i class="fa-solid fa-user"></i>&nbsp;@item.PassengerSeats
                                    </span>
                                    <span class="d-flex align-items-center">
                                        <i class="fa-solid fa-gas-pump"></i>&nbsp;@item.FuelConsumption l/100km
                                    </span>
                                    <span class="d-flex align-items-center">
                                        <i class="fa-solid fa-horse"></i>&nbsp;@item.HorsePower hk
                                    </span>
                                </p>
                            </div>
                            <p style="font-size:1.3em; font-weight:bold">
                                @item.DailyCost kr/dygn
                            </p>
                            <a asp-controller="Car" asp-action="ShowCar" asp-route-id="@item.CarId" class="btn btn-dark">Läs mer & boka</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
@* </div> *@
